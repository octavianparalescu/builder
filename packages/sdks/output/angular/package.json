{
  "name": "@builder.io/sdk-angular",
  "version": "0.26.2",
  "homepage": "https://github.com/BuilderIO/builder/tree/main/packages/sdks/output/angular",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BuilderIO/builder.git",
    "directory": "packages/sdks/output/angular"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "release": "npm publish",
    "build-inline-fns": "yarn g:build-inline-fns",
    "generate-dynamic-renderer": "node ./scripts/generate-dynamic-renderer.mjs",
    "build": "yarn g:nx run-many -p @builder.io/sdk-angular -t build:node build:browser build:edge --parallel=false",
    "build:node": "cross-env SDK_ENV=node node ./scripts/multi-build.mjs",
    "build:browser": "cross-env SDK_ENV=browser node ./scripts/multi-build.mjs",
    "build:edge": "cross-env SDK_ENV=edge node ./scripts/multi-build.mjs"
  },
  "dependencies": {
    "isolated-vm": "^6.0.0",
    "tslib": "^2.3.0"
  },
  "peerDependencies": {
    "@angular/common": ">=19.0.0",
    "@angular/core": ">=19.0.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.13",
    "@angular/animations": "21.2.15",
    "@angular/cli": "21.2.13",
    "@angular/common": "21.2.15",
    "@angular/compiler": "21.2.15",
    "@angular/compiler-cli": "21.2.15",
    "@angular/core": "21.2.15",
    "@angular/forms": "21.2.15",
    "@angular/platform-browser": "21.2.15",
    "@angular/platform-browser-dynamic": "21.2.15",
    "@angular/router": "21.2.15",
    "@builder.io/sdks": "workspace:*",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^22.15.32",
    "cross-env": "^7.0.3",
    "glob": "^7.2.3",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "21.2.7",
    "recast": "^0.23.4",
    "rimraf": "^3.0.2",
    "rxjs": "~7.8.2",
    "tslib": "^2.3.0",
    "typescript": "5.9.3",
    "zone.js": "0.16.2"
  },
  "sideEffects": false,
  "nx": {
    "targets": {
      "build-inline-fns": {
        "dependsOn": [
          "^build:angular"
        ]
      },
      "generate-dynamic-renderer": {
        "dependsOn": [
          "^build:angular"
        ]
      },
      "build": {
        "dependsOn": [
          "build-inline-fns",
          "generate-dynamic-renderer",
          "^build:angular",
          "^build"
        ],
        "outputs": [
          "{projectRoot}/lib"
        ]
      }
    }
  },
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "node": {
        "esm2022": "./lib/node/esm2022/builder.io-sdk-angular.mjs",
        "esm": "./lib/node/esm2022/builder.io-sdk-angular.mjs",
        "types": "./lib/node/types/builder.io-sdk-angular.d.ts",
        "default": "./lib/node/fesm2022/builder.io-sdk-angular.mjs"
      },
      "browser": {
        "esm2022": "./lib/browser/esm2022/builder.io-sdk-angular.mjs",
        "esm": "./lib/browser/esm2022/builder.io-sdk-angular.mjs",
        "types": "./lib/browser/types/builder.io-sdk-angular.d.ts",
        "default": "./lib/browser/fesm2022/builder.io-sdk-angular.mjs"
      },
      "edge": {
        "esm2022": "./lib/edge/esm2022/builder.io-sdk-angular.mjs",
        "esm": "./lib/edge/esm2022/builder.io-sdk-angular.mjs",
        "types": "./lib/edge/types/builder.io-sdk-angular.d.ts",
        "default": "./lib/edge/fesm2022/builder.io-sdk-angular.mjs"
      },
      "edge-routine": {
        "esm2022": "./lib/edge/esm2022/builder.io-sdk-angular.mjs",
        "esm": "./lib/edge/esm2022/builder.io-sdk-angular.mjs",
        "types": "./lib/edge/types/builder.io-sdk-angular.d.ts",
        "default": "./lib/edge/fesm2022/builder.io-sdk-angular.mjs"
      },
      "netlify": {
        "esm2022": "./lib/edge/esm2022/builder.io-sdk-angular.mjs",
        "esm": "./lib/edge/esm2022/builder.io-sdk-angular.mjs",
        "types": "./lib/edge/types/builder.io-sdk-angular.d.ts",
        "default": "./lib/edge/fesm2022/builder.io-sdk-angular.mjs"
      },
      "types": "./lib/node/types/builder.io-sdk-angular.d.ts"
    },
    "./bundle/edge": {
      "esm2022": "./lib/edge/esm2022/builder.io-sdk-angular.mjs",
      "esm": "./lib/edge/esm2022/builder.io-sdk-angular.mjs",
      "types": "./lib/edge/types/builder.io-sdk-angular.d.ts",
      "default": "./lib/edge/fesm2022/builder.io-sdk-angular.mjs"
    }
  },
  "main": "lib/node/fesm2022/builder.io-sdk-angular.mjs",
  "module": "lib/node/fesm2022/builder.io-sdk-angular.mjs",
  "typings": "lib/node/types/builder.io-sdk-angular.d.ts",
  "types": "lib/node/types/builder.io-sdk-angular.d.ts"
}
